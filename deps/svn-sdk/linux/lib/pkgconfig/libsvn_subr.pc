prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libsvn_subr
Description: Subversion General Utility Library
Version: 1.16.0
Requires: apr-util-1, apr-1
Requires.private: sqlite3
Libs: -L${libdir}  -lsvn_subr-1 -L/usr/lib/x86_64-linux-gnu;-lexpat -L/usr/lib/x86_64-linux-gnu;-lz        
Cflags: -I${includedir}/subversion-1
