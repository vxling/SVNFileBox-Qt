prefix=${pcfiledir}/../..
SERF_MAJOR_VERSION=1
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include/serf-1

Name: serf
Description: HTTP client library
Version: 1.3.10
Requires.private: libssl libcrypto
Libs: "-L${libdir}" "-lserf-${SERF_MAJOR_VERSION}"
Libs.private: libaprutil-1.lib libapr-1.lib  -lz
Cflags: "-I${includedir}"

